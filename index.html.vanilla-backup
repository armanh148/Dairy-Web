<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Bondu Milk Shop — Premium Exotic Milks</title>
<meta name="description" content="Pakistan's finest exotic milks. Camel, Cow, Donkey & Dog milk delivered fresh to your door."/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollToPlugin.min.js"></script>
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{
  --gold:#c9a96e;--gold-light:#dfc08a;--gold-dark:#a88a4e;
  --bg:#080808;--bg-card:#111;--bg-surface:#161616;
  --text:#f0ece4;--text-muted:rgba(240,236,228,.45);--text-dim:rgba(240,236,228,.25);
  --border:rgba(255,255,255,.06);--border-hover:rgba(255,255,255,.12);
  --ease:cubic-bezier(.23,1,.32,1);--ease-out:cubic-bezier(.16,1,.3,1);
}
html{scroll-behavior:auto;overflow-x:hidden}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden;-webkit-font-smoothing:antialiased}
::selection{background:rgba(201,169,110,.3)}
img,video{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font:inherit;cursor:pointer;border:none;background:none;color:inherit}
input,textarea,select{font:inherit}

/* === PAGE LOADER === */
.loader{position:fixed;inset:0;z-index:10000;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.5rem}
.loader-brand{font-family:'Playfair Display',serif;font-size:clamp(2.5rem,6vw,4rem);font-weight:700;color:var(--gold);letter-spacing:-.02em}
.loader-bar{width:120px;height:1px;background:rgba(255,255,255,.08);overflow:hidden;border-radius:2px}
.loader-bar-fill{height:100%;width:0;background:var(--gold);border-radius:2px}

/* === GRAIN === */
.grain{position:fixed;inset:0;pointer-events:none;z-index:9990;opacity:.025;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}

/* === SCROLL PROGRESS === */
.scroll-bar{position:fixed;top:0;left:0;height:1px;background:linear-gradient(90deg,var(--gold-dark),var(--gold),var(--gold-light));z-index:9999;transform-origin:left;transform:scaleX(0);will-change:transform}

/* === CUSTOM CURSOR === */
.cursor-dot{position:fixed;width:6px;height:6px;background:var(--gold);border-radius:50%;pointer-events:none;z-index:9999;mix-blend-mode:difference;will-change:transform}
.cursor-ring{position:fixed;width:36px;height:36px;border:1px solid rgba(201,169,110,.35);border-radius:50%;pointer-events:none;z-index:9999;will-change:transform;transition:width .4s var(--ease),height .4s var(--ease),border-color .4s var(--ease)}
.cursor-ring.expand{width:56px;height:56px;border-color:var(--gold)}
@media(max-width:768px){.cursor-dot,.cursor-ring{display:none}}

/* === NAV === */
.nav{position:fixed;top:0;left:0;right:0;z-index:500;padding:0 clamp(1.5rem,4vw,3rem);transition:background .5s var(--ease),backdrop-filter .5s var(--ease)}
.nav.scrolled{background:rgba(8,8,8,.82);-webkit-backdrop-filter:blur(24px) saturate(1.2);backdrop-filter:blur(24px) saturate(1.2);border-bottom:1px solid var(--border)}
.nav-inner{max-width:1280px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:72px}
.nav-logo{display:flex;align-items:baseline;gap:.6rem}
.nav-logo-mark{font-family:'Playfair Display',serif;font-size:1.6rem;font-weight:700;color:var(--gold);letter-spacing:-.02em}
.nav-logo-sub{font-size:.65rem;font-weight:600;color:var(--text-dim);text-transform:uppercase;letter-spacing:.25em}
.nav-links{display:flex;gap:2.5rem}
.nav-link{font-size:.8rem;font-weight:500;color:var(--text-muted);letter-spacing:.04em;transition:color .3s;position:relative}
.nav-link::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:1px;background:var(--gold);transition:width .4s var(--ease)}
.nav-link:hover{color:var(--text)}
.nav-link:hover::after{width:100%}
.nav-actions{display:flex;align-items:center;gap:1rem}
.nav-cart{position:relative;width:40px;height:40px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;transition:border-color .3s,background .3s}
.nav-cart:hover{border-color:var(--border-hover);background:rgba(255,255,255,.03)}
.nav-cart svg{width:18px;height:18px;stroke:var(--text-muted)}
.nav-cart-count{position:absolute;top:-4px;right:-4px;width:18px;height:18px;background:var(--gold);color:#000;font-size:.6rem;font-weight:700;border-radius:50%;display:flex;align-items:center;justify-content:center;opacity:0;transform:scale(.6);transition:all .3s var(--ease)}
.nav-cart-count.visible{opacity:1;transform:scale(1)}
.nav-order-btn{padding:.6rem 1.5rem;background:var(--gold);color:#000;font-size:.75rem;font-weight:700;border-radius:100px;letter-spacing:.04em;transition:background .3s,transform .3s var(--ease),box-shadow .3s}
.nav-order-btn:hover{background:var(--gold-light);transform:translateY(-1px);box-shadow:0 8px 24px rgba(201,169,110,.2)}
.nav-mobile-btn{display:none;width:40px;height:40px;align-items:center;justify-content:center}
.nav-mobile-btn svg{width:20px;height:20px;stroke:var(--text-muted)}
@media(max-width:768px){.nav-links{display:none}.nav-order-btn{display:none}.nav-mobile-btn{display:flex}}

/* === MOBILE MENU === */
.mobile-menu{position:fixed;inset:0;z-index:490;background:rgba(8,8,8,.95);-webkit-backdrop-filter:blur(24px);backdrop-filter:blur(24px);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rem;opacity:0;pointer-events:none;transition:opacity .4s var(--ease)}
.mobile-menu.open{opacity:1;pointer-events:all}
.mobile-menu a{font-family:'Playfair Display',serif;font-size:2rem;font-weight:600;color:var(--text-muted);transition:color .3s}
.mobile-menu a:hover{color:var(--gold)}
.mobile-menu-close{position:absolute;top:1.5rem;right:1.5rem;width:44px;height:44px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center}

/* === HERO === */
.hero{position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden}
.hero-video-wrap{position:absolute;inset:0;z-index:0}
.hero-video{width:100%;height:100%;object-fit:cover;transform:scale(1.05)}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,8,8,.35) 0%,rgba(8,8,8,.55) 40%,rgba(8,8,8,.88) 100%)}
.hero-overlay-side{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,8,8,.8) 0%,rgba(8,8,8,.25) 50%,transparent 100%)}
.hero-content{position:relative;z-index:2;max-width:1280px;margin:0 auto;padding:8rem clamp(1.5rem,4vw,3rem) 4rem;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center}
.hero-text{max-width:600px}
.hero-badge{display:inline-flex;align-items:center;gap:.5rem;padding:.45rem 1.2rem;border:1px solid rgba(201,169,110,.25);border-radius:100px;font-size:.65rem;font-weight:600;color:var(--gold);text-transform:uppercase;letter-spacing:.2em;margin-bottom:2rem;backdrop-filter:blur(12px);background:rgba(201,169,110,.04)}
.hero-badge-dot{width:5px;height:5px;border-radius:50%;background:var(--gold);animation:pulseDot 2s ease-in-out infinite}
@keyframes pulseDot{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.8)}}
.hero-title{font-family:'Playfair Display',serif;font-size:clamp(3rem,6.5vw,5.5rem);font-weight:800;line-height:1;letter-spacing:-.03em;margin-bottom:1.5rem}
.hero-title .line{display:block;overflow:hidden}
.hero-title .line span{display:inline-block}
.hero-title .accent{color:var(--gold)}
.hero-desc{font-size:clamp(.95rem,1.2vw,1.1rem);color:var(--text-muted);line-height:1.75;margin-bottom:2.5rem;max-width:440px}
.hero-actions{display:flex;gap:1rem;flex-wrap:wrap}
.btn-primary{display:inline-flex;align-items:center;gap:.6rem;padding:.9rem 2.2rem;background:var(--gold);color:#000;font-size:.85rem;font-weight:700;border-radius:100px;letter-spacing:.02em;transition:all .4s var(--ease);box-shadow:0 4px 20px rgba(201,169,110,.2)}
.btn-primary:hover{background:var(--gold-light);transform:translateY(-2px);box-shadow:0 8px 32px rgba(201,169,110,.3)}
.btn-primary svg{width:16px;height:16px;transition:transform .3s var(--ease)}
.btn-primary:hover svg{transform:translateX(3px)}
.btn-ghost{display:inline-flex;align-items:center;gap:.6rem;padding:.9rem 2.2rem;border:1px solid var(--border);color:var(--text);font-size:.85rem;font-weight:600;border-radius:100px;letter-spacing:.02em;transition:all .4s var(--ease)}
.btn-ghost:hover{border-color:var(--border-hover);background:rgba(255,255,255,.03)}

/* Hero floating tags */
.hero-visual{position:relative;height:500px;display:flex;align-items:center;justify-content:center}
.hero-rings{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
.hero-ring{position:absolute;border-radius:50%;border:1px solid rgba(201,169,110,.06)}
.hero-ring:nth-child(1){width:320px;height:320px}
.hero-ring:nth-child(2){width:420px;height:420px;border-color:rgba(201,169,110,.03)}
.float-card{position:absolute;background:rgba(255,255,255,.04);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.07);border-radius:16px;padding:.85rem 1.2rem;display:flex;align-items:center;gap:.75rem;box-shadow:0 8px 32px rgba(0,0,0,.3);z-index:10}
.float-card-icon{font-size:1.5rem}
.float-card-text{display:flex;flex-direction:column}
.float-card-title{font-size:.7rem;font-weight:700;color:var(--text);letter-spacing:.02em}
.float-card-sub{font-size:.6rem;color:var(--text-dim);margin-top:1px}
.float-card:nth-child(1){top:8%;left:0;animation:fc 5s ease-in-out infinite}
.float-card:nth-child(2){top:4%;right:5%;animation:fc 5s ease-in-out .8s infinite}
.float-card:nth-child(3){bottom:22%;left:5%;animation:fc 5s ease-in-out 1.6s infinite}
.float-card:nth-child(4){bottom:12%;right:2%;animation:fc 5s ease-in-out 2.4s infinite}
@keyframes fc{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}

/* Scroll hint */
.hero-scroll{position:absolute;bottom:2.5rem;left:50%;transform:translateX(-50%);z-index:2;display:flex;flex-direction:column;align-items:center;gap:.6rem;opacity:.35}
.hero-scroll span{font-size:.55rem;text-transform:uppercase;letter-spacing:.3em;color:var(--text-dim)}
.hero-scroll-line{width:1px;height:48px;background:linear-gradient(to bottom,var(--gold),transparent);position:relative;overflow:hidden}
.hero-scroll-dot{width:100%;height:12px;background:var(--gold);position:absolute;top:-12px;animation:scrollDot 2.2s ease-in-out infinite}
@keyframes scrollDot{0%{top:-12px}100%{top:48px}}

@media(max-width:1024px){.hero-content{grid-template-columns:1fr}.hero-visual{display:none}.hero-text{max-width:100%}}

/* === MARQUEE === */
.marquee{padding:2rem 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);overflow:hidden}
.marquee-track{display:flex;gap:4rem;animation:marqueeScroll 30s linear infinite;width:max-content}
.marquee-item{font-family:'Playfair Display',serif;font-size:clamp(3rem,6vw,5rem);font-weight:800;white-space:nowrap;color:rgba(255,255,255,.025);letter-spacing:-.02em;user-select:none}
.marquee-sep{font-size:clamp(3rem,6vw,5rem);color:rgba(201,169,110,.08);user-select:none}
@keyframes marqueeScroll{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

/* === STATS === */
.stats{padding:clamp(3rem,6vw,5rem) 0;border-bottom:1px solid var(--border)}
.stats-inner{max-width:1280px;margin:0 auto;padding:0 clamp(1.5rem,4vw,3rem)}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;text-align:center}
.stat-item{padding:1rem 0}
.stat-value{font-family:'Playfair Display',serif;font-size:clamp(2rem,4vw,3rem);font-weight:800;color:var(--gold);line-height:1}
.stat-label{font-size:.7rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:.15em;margin-top:.5rem}
@media(max-width:768px){.stats-grid{grid-template-columns:repeat(2,1fr)}}

/* === SECTION COMMON === */
.section{padding:clamp(4rem,8vw,7rem) 0}
.section-inner{max-width:1280px;margin:0 auto;padding:0 clamp(1.5rem,4vw,3rem)}
.section-label{display:inline-flex;align-items:center;gap:.5rem;padding:.4rem 1rem;border:1px solid rgba(201,169,110,.15);border-radius:100px;font-size:.6rem;font-weight:600;color:var(--gold);text-transform:uppercase;letter-spacing:.2em;margin-bottom:1.25rem}
.section-title{font-family:'Playfair Display',serif;font-size:clamp(2rem,4.5vw,3.5rem);font-weight:800;line-height:1.1;letter-spacing:-.02em;margin-bottom:1rem}
.section-title .accent{color:var(--gold)}
.section-desc{font-size:clamp(.9rem,1.1vw,1.05rem);color:var(--text-muted);line-height:1.7;max-width:540px}

/* === PRODUCTS TABS === */
.product-tabs{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;margin-bottom:3.5rem}
.product-tab{padding:.6rem 1.5rem;border:1px solid var(--border);border-radius:100px;font-size:.75rem;font-weight:600;color:var(--text-muted);transition:all .4s var(--ease);letter-spacing:.02em}
.product-tab:hover{border-color:var(--border-hover);color:var(--text)}
.product-tab.active{background:rgba(201,169,110,.08);border-color:rgba(201,169,110,.3);color:var(--gold)}

/* === FEATURED SHOWCASE === */
.showcase{background:var(--bg-card);border:1px solid var(--border);border-radius:24px;overflow:hidden;display:grid;grid-template-columns:1fr 1fr}
.showcase-media{position:relative;min-height:420px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,rgba(201,169,110,.03),transparent);overflow:hidden}
.showcase-media::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,rgba(201,169,110,.06),transparent 70%)}
.showcase-emoji{font-size:clamp(8rem,14vw,12rem);position:relative;z-index:2;filter:drop-shadow(0 20px 40px rgba(0,0,0,.3));transition:transform .6s var(--ease)}
.showcase-badge{position:absolute;top:1.5rem;left:1.5rem;z-index:10;display:flex;align-items:center;gap:.4rem;padding:.45rem 1rem;background:var(--gold);color:#000;font-size:.6rem;font-weight:700;border-radius:100px;text-transform:uppercase;letter-spacing:.1em;box-shadow:0 4px 16px rgba(201,169,110,.3)}
.showcase-tabs{position:absolute;bottom:1.5rem;left:1.5rem;right:1.5rem;z-index:10;display:grid;grid-template-columns:repeat(4,1fr);gap:.4rem}
.showcase-tab{padding:.7rem .5rem;background:rgba(255,255,255,.04);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.05);border-radius:12px;font-size:.65rem;font-weight:600;color:var(--text-dim);text-align:center;transition:all .35s var(--ease);cursor:pointer}
.showcase-tab:hover{background:rgba(255,255,255,.08);color:var(--text-muted)}
.showcase-tab.active{background:rgba(201,169,110,.1);border-color:rgba(201,169,110,.25);color:var(--gold)}
.showcase-info{padding:clamp(2rem,4vw,3.5rem);display:flex;flex-direction:column;justify-content:center}
.showcase-info-label{font-size:.6rem;font-weight:600;color:var(--gold);text-transform:uppercase;letter-spacing:.25em;margin-bottom:1rem}
.showcase-info-name{font-family:'Playfair Display',serif;font-size:clamp(2rem,3.5vw,2.8rem);font-weight:800;letter-spacing:-.02em;margin-bottom:.5rem}
.showcase-info-price{font-family:'Playfair Display',serif;font-size:clamp(2.2rem,4vw,3.2rem);font-weight:800;color:var(--gold);margin-bottom:1.25rem;line-height:1}
.showcase-info-price .unit{font-family:'Inter',sans-serif;font-size:.9rem;font-weight:400;color:var(--text-dim);margin-left:.25rem}
.showcase-info-desc{font-size:.95rem;color:var(--text-muted);line-height:1.75;margin-bottom:1.5rem;max-width:400px}
.showcase-tags{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:2rem}
.showcase-tag{padding:.4rem 1rem;border-radius:100px;font-size:.65rem;font-weight:700;letter-spacing:.05em}
.showcase-tag.green{background:rgba(34,197,94,.08);color:#4ade80;border:1px solid rgba(34,197,94,.15)}
.showcase-tag.blue{background:rgba(59,130,246,.08);color:#60a5fa;border:1px solid rgba(59,130,246,.15)}
.showcase-tag.pink{background:rgba(236,72,153,.08);color:#f472b6;border:1px solid rgba(236,72,153,.15)}
.showcase-tag.purple{background:rgba(168,85,247,.08);color:#c084fc;border:1px solid rgba(168,85,247,.15)}
.showcase-tag.orange{background:rgba(249,115,22,.08);color:#fb923c;border:1px solid rgba(249,115,22,.15)}
.showcase-tag.sky{background:rgba(14,165,233,.08);color:#38bdf8;border:1px solid rgba(14,165,233,.15)}
@media(max-width:1024px){.showcase{grid-template-columns:1fr}.showcase-media{min-height:300px}}

/* === PRODUCT GRID === */
.product-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.25rem}
@media(max-width:1024px){.product-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.product-grid{grid-template-columns:1fr}}
.product-card{background:var(--bg-card);border:1px solid var(--border);border-radius:20px;overflow:hidden;transition:all .5s var(--ease);position:relative}
.product-card:hover{border-color:var(--border-hover);transform:translateY(-6px);box-shadow:0 20px 40px rgba(0,0,0,.25)}
.product-card.featured{border-color:rgba(201,169,110,.2)}
.product-card.featured:hover{border-color:rgba(201,169,110,.35);box-shadow:0 20px 40px rgba(0,0,0,.25),0 0 40px rgba(201,169,110,.08)}
.product-card-img{height:200px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.product-card-img span{font-size:4.5rem;transition:transform .6s var(--ease)}
.product-card:hover .product-card-img span{transform:scale(1.15)}
.product-card-badge{position:absolute;top:.75rem;left:.75rem;padding:.3rem .8rem;border-radius:100px;font-size:.55rem;font-weight:700;background:var(--gold);color:#000;text-transform:uppercase;letter-spacing:.08em}
.product-card-body{padding:1.25rem 1.5rem 1.5rem}
.product-card-name{font-family:'Playfair Display',serif;font-size:1.15rem;font-weight:700;margin-bottom:.25rem}
.product-card-price{font-family:'Playfair Display',serif;font-size:1.4rem;font-weight:800;color:var(--gold);margin-bottom:.5rem}
.product-card-price .unit{font-family:'Inter',sans-serif;font-size:.7rem;font-weight:400;color:var(--text-dim)}
.product-card-desc{font-size:.8rem;color:var(--text-muted);line-height:1.6;margin-bottom:.75rem}
.product-card-tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-bottom:1rem}
.product-card-tag{padding:.25rem .6rem;border-radius:100px;font-size:.55rem;font-weight:700;letter-spacing:.04em}
.product-card-btn{width:100%;padding:.75rem;border-radius:12px;font-size:.8rem;font-weight:700;transition:all .35s var(--ease)}
.product-card-btn.gold{background:var(--gold);color:#000}
.product-card-btn.gold:hover{background:var(--gold-light);box-shadow:0 4px 16px rgba(201,169,110,.25)}
.product-card-btn.ghost{background:rgba(255,255,255,.04);color:var(--text-muted);border:1px solid var(--border)}
.product-card-btn.ghost:hover{background:rgba(255,255,255,.07);color:var(--text)}

/* === ABOUT === */
.about-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(3rem,6vw,5rem);align-items:center}
.about-features{list-style:none;display:flex;flex-direction:column;gap:1rem;margin-bottom:2.5rem}
.about-feature{display:flex;align-items:flex-start;gap:1rem}
.about-feature-icon{width:32px;height:32px;border-radius:50%;background:rgba(201,169,110,.08);border:1px solid rgba(201,169,110,.12);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.7rem;color:var(--gold)}
.about-feature-text{font-size:.9rem;color:var(--text-muted);line-height:1.6}
.about-cards{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.about-card{background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:1.75rem;text-align:center;transition:all .4s var(--ease)}
.about-card:hover{border-color:var(--border-hover);transform:translateY(-4px)}
.about-card-emoji{font-size:2.5rem;margin-bottom:.75rem;display:block;transition:transform .4s var(--ease)}
.about-card:hover .about-card-emoji{transform:scale(1.1) translateY(-4px)}
