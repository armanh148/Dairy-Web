<!-- CHECKOUT OVERLAY -->
<div id="checkoutOverlay" class="checkout-overlay">
  <div class="checkout-backdrop" onclick="closeCheckout()"></div>
  <div class="checkout-panel">
    <div class="checkout-sheet">
      <div class="checkout-head">
        <div>
          <h3>Place Your Order</h3>
          <p>Fill in your details and we'll deliver fresh milk to your doorstep.</p>
        </div>
        <button class="checkout-close" onclick="closeCheckout()">
          <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <form id="checkoutForm" onsubmit="handleCheckout(event)">
        <div class="form-group">
          <label class="form-label">Full Name</label>
          <input class="form-input" id="custName" required placeholder="e.g. Ahmed Khan"/>
        </div>
        <div class="form-group">
          <label class="form-label">Phone Number</label>
          <input class="form-input" id="custPhone" type="tel" required placeholder="e.g. 03001234567"/>
        </div>
        <div class="form-group">
          <label class="form-label">Delivery Address</label>
          <textarea class="form-input" id="custAddress" required rows="2" placeholder="House #, Street, Area, City" style="resize:none"></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Milk Type</label>
            <select class="form-select" id="milkType" onchange="updateBill()">
              <option value="400">Camel Milk (Rs. 400/L)</option>
              <option value="180">Cow Milk (Rs. 180/L)</option>
              <option value="500">Donkey Milk (Rs. 500/L)</option>
              <option value="800">Dog Milk (Rs. 800/L)</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Quantity (Liters)</label>
            <input class="form-input" id="milkQty" type="number" min="1" max="100" value="1" oninput="updateBill()"/>
          </div>
        </div>
        <div class="bill-box">
          <div class="bill-row"><span>Price per Liter</span><span id="billRate">Rs. 400</span></div>
          <div class="bill-row"><span>Quantity</span><span id="billQty">1 L</span></div>
          <div class="bill-divider"></div>
          <div class="bill-total"><span>Total Bill</span><span id="billTotal">Rs. 400</span></div>
        </div>
        <button type="submit" class="form-submit">Confirm Order</button>
      </form>
    </div>
  </div>
</div>

<!-- SUCCESS MODAL -->
<div id="successOverlay" class="success-overlay">
  <div class="success-backdrop" onclick="closeSuccess()"></div>
  <div class="success-card" id="successCard">
    <div class="success-icon">
      <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
    </div>
    <h3>Order Confirmed!</h3>
    <p id="successMsg">Your fresh milk will be delivered soon.</p>
    <button class="success-btn" onclick="closeSuccess()">Done</button>
  </div>
</div>

<script>
(function(){
  'use strict';

  // ============ LOADER ============
  const loader = document.getElementById('loader');
  const loaderFill = document.getElementById('loaderFill');
  gsap.to(loaderFill, {width:'100%', duration:1.6, ease:'power2.inOut', onComplete(){
    gsap.to(loader, {yPercent:-100, duration:.8, ease:'power4.inOut', delay:.2, onComplete(){
      loader.style.display='none';
      runHeroAnim();
      initScrollAnim();
    }});
  }});

  // ============ CUSTOM CURSOR ============
  const dot = document.getElementById('cursorDot');
  const ring = document.getElementById('cursorRing');
  let mx=0,my=0,rx=0,ry=0;
  document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;gsap.set(dot,{x:mx-3,y:my-3})});
  (function tick(){rx+=(mx-rx)*.12;ry+=(my-ry)*.12;gsap.set(ring,{x:rx-18,y:ry-18});requestAnimationFrame(tick)})();
  document.addEventListener('mouseover',e=>{
    const t=e.target.closest('a,button,[data-magnetic]');
    if(t)ring.classList.add('expand');
  });
  document.addEventListener('mouseout',e=>{
    const t=e.target.closest('a,button,[data-magnetic]');
    if(t)ring.classList.remove('expand');
  });

  // ============ MAGNETIC BUTTONS ============
  document.querySelectorAll('[data-magnetic]').forEach(el=>{
    el.addEventListener('mousemove',e=>{
      const r=el.getBoundingClientRect();
      gsap.to(el,{x:(e.clientX-r.left-r.width/2)*.25,y:(e.clientY-r.top-r.height/2)*.25,duration:.4,ease:'power2.out'});
    });
    el.addEventListener('mouseleave',()=>{gsap.to(el,{x:0,y:0,duration:.7,ease:'elastic.out(1,.4)'})});
  });

  // ============ SCROLL PROGRESS ============
  const scrollBar = document.getElementById('scrollBar');
  window.addEventListener('scroll',()=>{
    const p = window.scrollY/(document.documentElement.scrollHeight-window.innerHeight);
    gsap.set(scrollBar,{scaleX:p,transformOrigin:'left'});
  });

  // ============ NAV SCROLL ============
  const nav = document.getElementById('nav');
  window.addEventListener('scroll',()=>{
    nav.classList.toggle('scrolled', window.scrollY > 60);
  });

  // ============ MOBILE MENU ============
  document.getElementById('mobileOpen').addEventListener('click',()=>{document.getElementById('mobileMenu').classList.add('open')});
  document.getElementById('mobileClose').addEventListener('click',()=>{document.getElementById('mobileMenu').classList.remove('open')});
  window.closeMobileMenu = function(){document.getElementById('mobileMenu').classList.remove('open')};

  // ============ SMOOTH SCROLL ============
  document.querySelectorAll('a[href^="#"]').forEach(a=>{
    a.addEventListener('click',function(e){
      e.preventDefault();
      const t=document.querySelector(this.getAttribute('href'));
      if(t)gsap.to(window,{duration:1,scrollTo:{y:t,offsetY:72},ease:'power3.inOut'});
      closeMobileMenu();
    });
  });

  // ============ HERO ANIMATION ============
  function runHeroAnim(){
    const tl = gsap.timeline({delay:.2});
    tl.from('[data-anim="hero"] .hero-badge',{y:40,opacity:0,duration:.9,ease:'power4.out'})
      .from('[data-anim="hero"] .line span',{y:'110%',opacity:0,duration:1,ease:'power4.out',stagger:.12},'-=.5')
      .from('[data-anim="hero"] .hero-desc',{y:30,opacity:0,duration:.7,ease:'power3.out'},'-=.4')
      .from('[data-anim="hero"] .hero-actions',{y:20,opacity:0,duration:.6,ease:'power3.out'},'-=.3')
      .from('.hero-visual .float-card',{scale:.85,opacity:0,duration:.7,ease:'back.out(1.4)',stagger:.1},'-=.5')
      .from('.hero-rings .hero-ring',{scale:.7,opacity:0,duration:1,ease:'power2.out',stagger:.15},'-=.8');

    // Hero video parallax
    gsap.to('#heroVideo',{yPercent:15,scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}});
  }

  // ============ SCROLL ANIMATIONS ============
  function initScrollAnim(){
    gsap.registerPlugin(ScrollTrigger);

    // Generic reveals
    document.querySelectorAll('[data-reveal]').forEach(el=>{
      gsap.from(el,{y:50,opacity:0,scale:.98,duration:.9,ease:'power3.out',
        scrollTrigger:{trigger:el,start:'top 88%',toggleActions:'play none none none'}});
    });

    // Stat counters
    document.querySelectorAll('.stat-value[data-count]').forEach(el=>{
      const target = parseInt(el.dataset.count);
      const suffix = target>=100?'+':'+';
      ScrollTrigger.create({trigger:el,start:'top 85%',onEnter(){
        gsap.to(el,{innerHTML:target,duration:2.2,snap:'innerHTML',ease:'power2.out',
          onUpdate(){el.textContent=Math.round(parseFloat(el.textContent))+suffix}});
      }});
    });

    // Product cards stagger
    gsap.from('.product-card',{y:60,opacity:0,scale:.96,duration:.7,stagger:.12,ease:'power3.out',
      scrollTrigger:{trigger:'#productGrid',start:'top 85%'}});

    // About cards stagger
    gsap.from('.about-card',{y:30,opacity:0,scale:.96,duration:.6,stagger:.08,ease:'power3.out',
      scrollTrigger:{trigger:'.about-cards',start:'top 82%'}});
  }

  // ============ PRODUCT FILTER ============
  const tabs = document.querySelectorAll('.product-tab');
  const cards = document.querySelectorAll('.product-card');
  tabs.forEach(tab=>{
    tab.addEventListener('click',function(){
      tabs.forEach(t=>t.classList.remove('active'));
      this.classList.add('active');
      const f = this.dataset.filter;
      cards.forEach(c=>{
        if(f==='all'||c.dataset.category===f){
          gsap.to(c,{opacity:1,scale:1,y:0,duration:.5,ease:'power3.out',display:'block'});
        } else {
          gsap.to(c,{opacity:0,scale:.96,y:15,duration:.3,ease:'power2.in',onComplete:()=>{c.style.display='none'}});
        }
      });
    });
  });

  // ============ SHOWCASE TABS ============
  const showcaseData={
    camel:{emoji:'🐪',name:'Camel Milk',price:'400',desc:'Diabetes control aur insulin support. Rich in natural insulin-like proteins that help regulate blood sugar naturally.',tags:[{t:'DIABETES',c:'green'},{t:'INSULIN',c:'blue'}],priceRaw:400},
    cow:{emoji:'🐄',name:'Cow Milk',price:'180',desc:'Haddi mazboot aur calcium se bharpoor. Daily strength for the whole family with essential nutrients.',tags:[{t:'CALCIUM',c:'green'},{t:'BONES',c:'orange'}],priceRaw:180},
    donkey:{emoji:'🫏',name:'Donkey Milk',price:'500',desc:'Skin glow aur immunity booster. A natural beauty and health secret used since ancient times.',tags:[{t:'GLOW',c:'pink'},{t:'IMMUNITY',c:'purple'}],priceRaw:500},
    dog:{emoji:'🐕',name:'Dog Milk',price:'800',desc:'High fat aur protein for puppies. Premium nutrition packed with essential fatty acids for your furry friends.',tags:[{t:'PROTEIN',c:'sky'},{t:'HIGH FAT',c:'blue'}],priceRaw:800}
  };
  const sTabs=document.querySelectorAll('.showcase-tab');
  sTabs.forEach(t=>{
    t.addEventListener('click',function(){
      sTabs.forEach(s=>s.classList.remove('active'));
      this.classList.add('active');
      const d=showcaseData[this.dataset.milk];
      const tl=gsap.timeline();
      tl.to('#showcaseEmoji',{scale:.8,opacity:0,duration:.25,ease:'power2.in'})
        .call(()=>{document.getElementById('showcaseEmoji').textContent=d.emoji})
        .to('#showcaseEmoji',{scale:1,opacity:1,duration:.5,ease:'back.out(1.7)'})
        .to('#scName,#scPrice,#scDesc,#scTags,#scOrderBtn',{y:12,opacity:0,duration:.2},0)
        .call(()=>{
          document.getElementById('scName').textContent=d.name;
          document.getElementById('scPrice').innerHTML='Rs. '+d.price+'<span class="unit">/L</span>';
          document.getElementById('scDesc').textContent=d.desc;
          document.getElementById('scTags').innerHTML=d.tags.map(t=>'<span class="showcase-tag '+t.c+'">'+t.t+'</span>').join('');
          document.getElementById('scOrderBtn').setAttribute('onclick',"openCheckout('"+d.name+"',"+d.priceRaw+")");
        })
        .from('#scName',{y:15,opacity:0,duration:.35,ease:'power3.out'})
        .from('#scPrice',{y:12,opacity:0,duration:.3,ease:'power3.out'},'-=.2')
        .from('#scDesc',{y:10,opacity:0,duration:.3,ease:'power3.out'},'-=.2')
        .from('#scTags .showcase-tag',{scale:.85,opacity:0,duration:.3,stagger:.08,ease:'back.out(1.5)'},'-=.2')
        .from('#scOrderBtn',{y:8,opacity:0,duration:.3,ease:'power3.out'},'-=.15');
    });
  });

  // ============ CART ============
  let cart=[];
  function renderCart(){
    const body=document.getElementById('cartBody');
    const badge=document.getElementById('cartCount');
    const totalEl=document.getElementById('cartTotal');
    const totalItems=cart.reduce((s,i)=>s+i.qty,0);
    const totalPrice=cart.reduce((s,i)=>s+i.price*i.qty,0);
    badge.textContent=totalItems;
    badge.classList.toggle('visible',totalItems>0);
    totalEl.textContent='Rs. '+totalPrice;
    if(!cart.length){body.innerHTML='<div class="cart-empty">Your cart is empty</div>';return}
    body.innerHTML=cart.map((it,i)=>`
      <div class="cart-item">
        <span class="cart-item-emoji">${it.emoji}</span>
        <div class="cart-item-info">
          <div class="cart-item-name">${it.name}</div>
          <div class="cart-item-price">Rs. ${it.price}/L</div>
          <div class="cart-item-qty">
            <button onclick="cartChange(${i},-1)">-</button>
            <span>${it.qty}L</span>
            <button onclick="cartChange(${i},1)">+</button>
          </div>
        </div>
      </div>`).join('');
  }
  window.cartChange=function(i,d){cart[i].qty+=d;if(cart[i].qty<=0)cart.splice(i,1);renderCart()};

  function openCart(){document.getElementById('cartOverlay').classList.add('open');document.getElementById('cartPanel').classList.add('open');document.body.style.overflow='hidden'}
  function closeCart(){document.getElementById('cartOverlay').classList.remove('open');document.getElementById('cartPanel').classList.remove('open');document.body.style.overflow=''}
  window.closeCart=closeCart;
  document.getElementById('cartBtn').addEventListener('click',openCart);
  document.getElementById('cartClose').addEventListener('click',closeCart);
  document.getElementById('cartOverlay').addEventListener('click',closeCart);

  // ============ CHECKOUT ============
  window.openCheckout=function(milk,price){
    closeCart();
    const o=document.getElementById('checkoutOverlay');
    o.classList.add('open');
    document.body.style.overflow='hidden';
    if(milk&&price){
      const sel=document.getElementById('milkType');
      for(let i=0;i<sel.options.length;i++){if(parseInt(sel.options[i].value)===price){sel.selectedIndex=i;break}}
      updateBill();
    }
  };
  function closeCheckout(){document.getElementById('checkoutOverlay').classList.remove('open');document.body.style.overflow=''}
  window.closeCheckout=closeCheckout;

  window.updateBill=function(){
    const p=parseInt(document.getElementById('milkType').value);
    const q=parseInt(document.getElementById('milkQty').value)||1;
    document.getElementById('billRate').textContent='Rs. '+p;
    document.getElementById('billQty').textContent=q+' L';
    document.getElementById('billTotal').textContent='Rs. '+(p*q);
  };

  window.handleCheckout=function(e){
    e.preventDefault();
    const name=document.getElementById('custName').value;
    const sel=document.getElementById('milkType');
    const milkName=sel.options[sel.selectedIndex].text.split(' (')[0];
    const price=parseInt(sel.value);
    const qty=parseInt(document.getElementById('milkQty').value)||1;
    const emojis={'Camel Milk':'🐪','Cow Milk':'🐄','Donkey Milk':'🫏','Dog Milk':'🐕'};
    const ex=cart.find(i=>i.name===milkName);
    if(ex)ex.qty+=qty;else cart.push({name:milkName,price,qty,emoji:emojis[milkName]||'🥛'});
    renderCart();
    closeCheckout();
    document.getElementById('successMsg').textContent=name+', your order for '+milkName+' (Rs. '+(price*qty)+') has been placed! Fresh milk will be delivered to your address soon.';
    setTimeout(()=>{
      document.getElementById('successOverlay').classList.add('open');
      gsap.from('#successCard',{scale:.85,opacity:0,duration:.5,ease:'back.out(1.5)'});
    },350);
    document.getElementById('checkoutForm').reset();
    updateBill();
  };

  window.closeSuccess=function(){
    gsap.to('#successCard',{scale:.85,opacity:0,duration:.3,ease:'power2.in',onComplete(){
      document.getElementById('successOverlay').classList.remove('open');
      document.body.style.overflow='';
      gsap.set('#successCard',{scale:1,opacity:1});
    }});
  };

})();
</script>
</body>
