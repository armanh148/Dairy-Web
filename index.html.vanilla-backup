<!-- CART OVERLAY + PANEL -->
<div id="cartOverlay" class="cart-overlay"></div>
<div id="cartPanel" class="cart-panel">
  <div class="cart-header">
    <h3>Your Cart</h3>
    <button id="cartClose" class="cart-close">
      <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
  <div id="cartBody" class="cart-body"><div class="cart-empty">Your cart is empty</div></div>
  <div class="cart-footer">
    <div class="cart-total-row"><span class="cart-total-label">Total</span><span id="cartTotal" class="cart-total-value">Rs. 0</span></div>
    <button class="cart-checkout-btn" onclick="closeCart();setTimeout(openCheckout,350)">Proceed to Checkout</button>
